<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:StudyFlow.Views"
       x:Class="StudyFlow.AppShell"
       Shell.TabBarBackgroundColor="#1E1E1E"
       Shell.TabBarForegroundColor="White"
       Shell.TabBarUnselectedColor="#777">

    <TabBar>
        <Tab Title="Головна">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>

        <Tab Title="Фокус">
            <ShellContent ContentTemplate="{DataTemplate views:FocusPage}" />
        </Tab>

        <Tab Title="Завдання">
            <ShellContent ContentTemplate="{DataTemplate views:TasksPage}" />
        </Tab>
    </TabBar>

</Shell>