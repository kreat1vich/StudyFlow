<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.FocusPage"
             Title="Фокус"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Картка таймера -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="16" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🔥 Режим фокусування" FontSize="16" FontAttributes="Bold" TextColor="White" />

                    <Entry x:Name="FocusSubjectInput" Placeholder="Назва завдання / предмету" PlaceholderColor="#777" TextColor="White" BackgroundColor="#2C2C2C" HeightRequest="45" />
                    <Entry x:Name="FocusDurationInput" Placeholder="Тривалість (хв)" PlaceholderColor="#777" TextColor="White" BackgroundColor="#2C2C2C" Keyboard="Numeric" HeightRequest="45" />

                    <Button x:Name="BtnStartFocus" Text="Почати сесію" Clicked="OnStartFocusClicked" BackgroundColor="#512BD4" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" />

                    <!-- Елементи таймера -->
                    <VerticalStackLayout x:Name="TimerActiveLayout" IsVisible="False" Spacing="15" HorizontalOptions="Center" Margin="0,10,0,0">
                        <Label x:Name="LblTimerDisplay" Text="25:00" FontSize="44" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Button x:Name="BtnPauseResume" Text="Пауза" Clicked="OnPauseResumeClicked" BackgroundColor="#F57C00" TextColor="White" CornerRadius="8" WidthRequest="110" HeightRequest="45" />
                            <Button x:Name="BtnEndEarly" Text="Завершити" Clicked="OnEndEarlyClicked" BackgroundColor="#C62828" TextColor="White" CornerRadius="8" WidthRequest="110" HeightRequest="45" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="TimerFinishedLayout" IsVisible="False" Spacing="12" Margin="0,10,0,0">
                        <Label Text="🎉 Сесію фокусування завершено!" FontSize="16" FontAttributes="Bold" TextColor="LightGreen" HorizontalOptions="Center" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Зберегти" Clicked="OnFinishTaskClicked" BackgroundColor="#512BD4" TextColor="White" CornerRadius="8" HeightRequest="45" />
                            <Button Grid.Column="1" Text="Ще раз" Clicked="OnContinueFocusClicked" BackgroundColor="#2C2C2C" TextColor="White" CornerRadius="8" HeightRequest="45" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Динамічний контейнер для нотаток -->
            <VerticalStackLayout x:Name="NotesContainer" Spacing="12" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>