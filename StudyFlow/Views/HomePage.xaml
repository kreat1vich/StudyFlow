<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.HomePage"
             Title="Головна"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <!-- ПРИВІТАННЯ -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="StudyFlow 🚀" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                <Label Text="Твій персональний менеджер навчання" FontSize="14" TextColor="#B0B0B0" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- СТАТИСТИКА -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="16" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📊 Загальна статистика часу" FontSize="18" FontAttributes="Bold" TextColor="White" />

                    <CollectionView x:Name="StatsCollection" HeightRequest="150" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto" Padding="0,6">
                                    <Label Grid.Column="0" Text="{Binding Subject}" TextColor="#B0B0B0" FontSize="15" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding TimeFormatted}" TextColor="White" FontAttributes="Bold" FontSize="15" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>