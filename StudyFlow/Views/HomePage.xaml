<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.HomePage"
             Title="Головна"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- ПРИВІТАННЯ -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="StudyFlow 🚀" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                <Label Text="Твій прогрес та статистика" FontSize="14" TextColor="#B0B0B0" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- ПЕРЕМИКАЧ ПЕРІОДІВ -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button x:Name="BtnDay" Text="День" Clicked="OnPeriodChanged" BackgroundColor="#2C2C2C" TextColor="White" CornerRadius="8" WidthRequest="90" />
                <Button x:Name="BtnWeek" Text="Тиждень" Clicked="OnPeriodChanged" BackgroundColor="#512BD4" TextColor="White" CornerRadius="8" WidthRequest="90" />
                <Button x:Name="BtnMonth" Text="Місяць" Clicked="OnPeriodChanged" BackgroundColor="#2C2C2C" TextColor="White" CornerRadius="8" WidthRequest="90" />
            </HorizontalStackLayout>

            <!-- КАРТКА З ПОКАЗНИКАМИ (СПИСКОМ) -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="16" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="📊 Загальні показники" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="0,0,0,4" />

                    <!-- Рядок 0: Загальний час -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Загальний час" TextColor="#B0B0B0" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="LblTotalTime" Text="0 год 00 хв" TextColor="White" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" />

                    <!-- Рядок 1: Сесій -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Сесій" TextColor="#B0B0B0" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="LblTotalSessions" Text="0" TextColor="White" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" />

                    <!-- Рядок 2: Середня сесія -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Середня сесія" TextColor="#B0B0B0" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="LblAvgSession" Text="0 хв" TextColor="White" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- НАЙБІЛЬШЕ ЧАСУ ПО ПРЕДМЕТАХ -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="16" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🏆 Найбільше часу:" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <CollectionView x:Name="StatsCollection" HeightRequest="130" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto" Padding="0,6">
                                    <Label Grid.Column="0" Text="{Binding Subject}" TextColor="#B0B0B0" FontSize="15" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding TimeFormatted}" TextColor="White" FontAttributes="Bold" FontSize="15" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- ГРАФІК АКТИВНОСТІ -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="16" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📈 Активність за тиждень" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <VerticalStackLayout x:Name="ChartLayout" Spacing="6" Margin="0,5,0,0">
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>