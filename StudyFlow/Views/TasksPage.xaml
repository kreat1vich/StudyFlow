<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.TasksPage"
             Title="Завдання"
             BackgroundColor="#121212">

    <!-- Загальний ScrollView дозволяє прокручувати всю сторінку -->
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Блок додавання завдання -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="16" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📌 Нове завдання" FontSize="16" FontAttributes="Bold" TextColor="White" />
                    <Entry x:Name="TitleInput" Placeholder="Назва завдання" PlaceholderColor="#777" TextColor="White" BackgroundColor="#2C2C2C" HeightRequest="45" />
                    <Entry x:Name="SubjectInput" Placeholder="Опис завдання" PlaceholderColor="#777" TextColor="White" BackgroundColor="#2C2C2C" HeightRequest="45" />
                    <Entry x:Name="DeadlineInput" Placeholder="Дедлайн завдання" PlaceholderColor="#777" TextColor="White" BackgroundColor="#2C2C2C" HeightRequest="45" />
                    <Button Text="Додати завдання" Clicked="OnAddClicked" BackgroundColor="#512BD4" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" />
                </VerticalStackLayout>
            </Frame>

            <!-- Заголовок списку -->
            <Label Text="📋 Список завдань:" FontSize="16" FontAttributes="Bold" TextColor="White" />

            <!-- 
              Використовуємо HeightRequest або прибираємо обмеження, 
              але щоб CollectionView всередині ScrollView працював коректно 
              і не сперечався зі скролом сторінки, задаємо фіксовану висоту 
              або використовуємо BindableLayout (або залишаємо так, якщо MAUI дозволяє).
            -->
            <CollectionView x:Name="TasksCollection" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="15" Padding="10">
                            <CheckBox IsChecked="{Binding IsCompleted}" 
                                 CheckedChanged="OnCheckBoxCheckedChanged"
                                 VerticalOptions="Center" />
                            <VerticalStackLayout WidthRequest="180">
                                <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                                <Label Text="{Binding Subject}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label Text="{Binding Deadline}" FontSize="12" TextColor="#FF5252" VerticalOptions="Center" />
                            <Button Text="❌" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" HeightRequest="40" BackgroundColor="#2A2A2A" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>