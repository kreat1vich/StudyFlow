<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyFlow.Views.TasksPage"
             Title="Завдання"
             BackgroundColor="#121212">

    <VerticalStackLayout Padding="16" Spacing="10">
        <CollectionView x:Name="TasksCollection" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout Spacing="15" Padding="10">
                        <CheckBox IsChecked="{Binding IsCompleted}" VerticalOptions="Center" />

                        <VerticalStackLayout WidthRequest="180">
                            <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{Binding Subject}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>

                        <Label Text="{Binding Deadline}" FontSize="12" TextColor="#FF5252" VerticalOptions="Center" />

                        <Button Text="❌" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" HeightRequest="40" BackgroundColor="#2A2A2A" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>